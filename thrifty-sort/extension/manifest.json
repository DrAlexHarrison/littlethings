{
  "manifest_version": 3,
  "name": "Thrifty Sort",
  "version": "1.8.1",
  "description": "Sorts Walmart and Amazon search results by price per ounce, per fluid ounce or per count, cheapest first.",
  "content_scripts": [
    {
      "matches": [
        "https://www.walmart.com/*",
        "https://www.amazon.com/*"
      ],
      "js": [
        "thrifty-sort.user.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "thrifty-sort@littlethings",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
